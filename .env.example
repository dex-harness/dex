# Copy to `.env` and fill in. `.env` is gitignored and never committed.

# ---------------------------------------------------------------------------
# Model provider (addendum section 11: OpenAI-compatible, fully configurable)
# ---------------------------------------------------------------------------

# Any OpenAI-compatible endpoint works. Defaults target OpenCode Zen Go.
DEX_BASE_URL=https://opencode.ai/zen/go/v1

# API key. `OPENCODE_GO_API_KEY` is the Zen Go name; `OPENCODE_API_KEY` also works.
OPENCODE_GO_API_KEY=

# Model id. Must be served by the /chat/completions endpoint of DEX_BASE_URL.
# Zen Go's OpenAI-compatible subset includes GLM, Kimi, LongCat, DeepSeek,
# MiMo, Hy and Space Bunny. Free and unlimited: space-bunny-free
# Coding-focused: kimi-k2.7-code
DEX_MODEL=kimi-k2.7-code

# Sent as a stable per-conversation header so the gateway can route and cache.
DEX_SESSION_HEADER=x-opencode-session

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# Unix socket the CLI connects to. Relative paths resolve under $HOME.
DEX_SOCKET=~/.dex/dex.sock

# Hard cap on simultaneously live sessions.
DEX_MAX_SESSIONS=32

# Maximum program executions in a single user turn before the turn is closed.
DEX_MAX_PROGRAM_ROUNDS=8

# ---------------------------------------------------------------------------
# Execution budgets (addendum section 9)
# ---------------------------------------------------------------------------

# Wall-clock ceiling for one program execution.
DEX_BUDGET_WALL_CLOCK_MS=30000

# Capability invocations permitted per program execution.
DEX_BUDGET_CAPABILITY_CALLS=100

# Filesystem bytes readable / writable per program execution.
DEX_BUDGET_READ_BYTES=33554432
DEX_BUDGET_WRITE_BYTES=8388608

# Output bytes retained from a single capability (command stdout/stderr etc).
DEX_BUDGET_OUTPUT_BYTES=262144

# Per-test-run wall clock.
DEX_BUDGET_COMMAND_MS=120000

# ---------------------------------------------------------------------------
# Authority (addendum section 3)
#
# Default is DENY. A capability runs only when its authority is granted here and
# the requested resource matches the scope. Semicolon-separated entries of
# `capability=scope`; scope `*` matches any resource, otherwise a glob is matched
# against the canonicalized absolute path.
#
# The entries below are the documented development grant for a repository at
# /work: read, write, git read/write, and the allowlisted test runner. No
# filesystem.delete, no network, no arbitrary process authority.
# ---------------------------------------------------------------------------

DEX_AUTHORITY=filesystem.read=/work/**;filesystem.write=/work/**;git.read=/work/**;git.write=/work/**;testing.run=/work/**;memory.read=*;memory.write=*;ui.interact=*;session.read=*

# ---------------------------------------------------------------------------
# Memory store (addendum section 6)
# ---------------------------------------------------------------------------

DEX_MEMORY_DIR=~/.dex/memory
